# Copy to deploy/.env and fill in. Keep it out of version control.
# 32 random bytes, base64: openssl rand -base64 32
# Back it up: without it stored credentials cannot be decrypted.
PLUGRELAY_MASTER_KEY=
# Operator Bearer token for the admin API and /metrics (optional).
PLUGRELAY_ADMIN_TOKEN=
POSTGRES_PASSWORD=
# PLUGRELAY_VERSION=latest
